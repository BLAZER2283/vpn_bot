# ── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-DEF...
# ID через запятую. Только эти люди видят админ-меню.
ADMIN_IDS=123456789

# Прокси до api.telegram.org. В РФ прямое подключение обычно не проходит
# (ошибка "Cannot connect to host api.telegram.org").
# На сервере за границей — оставить пустым.
# http://127.0.0.1:PORT | http://user:pass@host:port | socks5://host:port
TELEGRAM_PROXY=

# ── База ────────────────────────────────────────────────────────────────────
POSTGRES_USER=vpn
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vpn
# В docker-compose хост "db" — имя сервиса.
# Для локального запуска (python run_local.py) строку можно закомментировать:
# тогда возьмётся SQLite-файл рядом с проектом, Postgres не нужен.
DATABASE_URL=postgresql+asyncpg://vpn:changeme@db:5432/vpn

# ── Подписка ────────────────────────────────────────────────────────────────
# Публичный адрес, по которому клиенты забирают подписку.
# Пока IP, после покупки домена — https://sub.example.com
SUB_BASE_URL=http://2.26.22.168:8080
SUB_PORT=8080
SUB_TITLE=BLAZER VPN
SUB_UPDATE_INTERVAL_HOURS=12
SUPPORT_URL=https://t.me/yourusername
# Включать только если подписочный endpoint доступен исключительно через
# доверенный reverse proxy, который сам переписывает X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ── Правила ─────────────────────────────────────────────────────────────────
TRIAL_DAYS=2
DEVICE_LIMIT=6
# Ставить ли expiryTime в самой панели вдобавок к enable=false.
# Требует синхронных часов на нодах, поэтому по умолчанию выключено.
PANEL_SET_EXPIRY=false

# ── Прочее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
